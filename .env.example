# Capital Scope Behavioral Lab — Environment Variables
# Copy this file to .env.local and fill in your keys.
# NEVER commit real keys. .env / .env.* are gitignored (only this .env.example is tracked).

# ─── AI Features (research agents, future LLMInvestorAgent) ────────────────────
# Without this key, AI agents fall back to mock/demo data silently.
# The Behavioral Lab MVP does NOT make real LLM calls (rule-based agents only).
# Get your key at: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Optional: Financial Data APIs ─────────────────────────────────────────────
# Yahoo Finance (proxied via Vite) does NOT require a key.
#
# Financial Modeling Prep — analyst ratings (optional)
VITE_FMP_API_KEY=your-fmp-key-here
# Finnhub — analyst ratings / news sentiment (optional)
VITE_FINNHUB_API_KEY=your-finnhub-key-here

# ─── Backend ────────────────────────────────────────────────────────────────────
# FastAPI backend runs on an ISOLATED port (8100) so it can run alongside the
# upstream Capital Scope Terminal backend (8000) without collision.
# Start with: uvicorn main:app --reload --port 8100
# Vite dev server runs on 5273 and proxies /api/portfolio -> http://127.0.0.1:8100
# No env var needed for the backend URL in development.

# ─── Behavioral Lab (simulation defaults — safe, fictitious) ───────────────────
# These configure the deterministic simulation engine, not real markets.
VITE_LAB_DEFAULT_SEED=42
VITE_LAB_DEFAULT_AGENTS=6
VITE_LAB_DEFAULT_PERIODS=50
VITE_LAB_DEFAULT_RUNS_PER_VARIANT=20
VITE_LAB_FUNDAMENTAL_VALUE=60
